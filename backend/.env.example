# ──────────────────────────────────────────────
# OBytGemini Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────

# Database (Neon PostgreSQL)
# Pooler URL — used by the running app (serverless/WebSocket driver)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# Direct URL — used by drizzle-kit push/generate (direct TCP, no channel_binding)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DBNAME?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5000

# GitHub OAuth — create at https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:5000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — optional, add when credentials are available
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Provider Keys — only add keys you have
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
