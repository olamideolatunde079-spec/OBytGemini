# ──────────────────────────────────────────────
# OBytGemini Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────

# Database (Neon PostgreSQL)
# Pooler URL — used by the running app (node-postgres driver)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
# Direct URL — used by drizzle-kit push/generate (no pooler)
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Better Auth — generate a random 32+ character string
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:5000

# GitHub OAuth — create at https://github.com/settings/developers
# Homepage URL: http://localhost:5173
# Callback URL: http://localhost:5000/api/auth/callback/github
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret

# Google OAuth — optional, configure only if enabling Google sign-in
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# AI Provider Keys — add only the keys you have
GEMINI_API_KEY=your-google-ai-studio-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_API_KEY is an optional fallback for ANTHROPIC_API_KEY
CLAUDE_API_KEY=
XAI_API_KEY=your-xai-api-key

# Server
PORT=5000
FRONTEND_URL=http://localhost:5173
